---

---

<form id="subscribe-form" class="w-full max-w-md mx-auto" novalidate>
	<div class="flex flex-col sm:flex-row gap-3">
		<input
			type="email"
			id="email-input"
			name="email"
			placeholder="your@email.com"
			required
			autocomplete="email"
			class="flex-1 min-w-0 bg-transparent border border-white/20 text-[#f0ece4] text-[0.9375rem] px-4 py-3 outline-none placeholder:text-white/30 focus:border-[#c8922a] transition-colors duration-150 appearance-none"
		/>
		<button
			type="submit"
			id="subscribe-button"
			class="flex-shrink-0 inline-flex items-center justify-center gap-2 bg-[#c8922a] text-[#080808] text-[0.75rem] font-semibold tracking-[0.12em] uppercase px-7 py-3 border border-[#c8922a] hover:bg-[#a87520] hover:border-[#a87520] transition-colors duration-150 cursor-pointer disabled:opacity-40 disabled:pointer-events-none whitespace-nowrap"
		>
			<span id="button-text">Join the Community</span>
			<span
				id="button-loading"
				class="hidden size-[1.1em] border-2 border-white/20 border-t-[#f0ece4] rounded-full animate-spin"
			></span>
		</button>
	</div>

	<div
		id="message"
		class="hidden mt-4 text-sm font-medium tracking-wide"
		role="alert"
		aria-live="polite"
	>
	</div>
</form>

<script>
	const form = document.getElementById("subscribe-form") as HTMLFormElement;
	const emailInput = document.getElementById(
		"email-input",
	) as HTMLInputElement;
	const submitButton = document.getElementById(
		"subscribe-button",
	) as HTMLButtonElement;
	const buttonText = document.getElementById(
		"button-text",
	) as HTMLSpanElement;
	const buttonLoading = document.getElementById(
		"button-loading",
	) as HTMLSpanElement;
	const messageDiv = document.getElementById("message") as HTMLDivElement;

	form.addEventListener("submit", async (e) => {
		e.preventDefault();

		const email = emailInput.value.trim();

		if (!email) {
			showMessage("Please enter your email address.", "error");
			return;
		}

		setLoading(true);
		hideMessage();

		try {
			const response = await fetch("/api/subscribe", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ email }),
			});

			const data = await response.json();

			if (response.ok) {
				showMessage(
					"🤘 You're in. Welcome to Homesick Highway.",
					"success",
				);
				emailInput.value = "";
			} else {
				showMessage(
					data.error || "Something went wrong. Please try again.",
					"error",
				);
			}
		} catch {
			showMessage(
				"Network error. Check your connection and try again.",
				"error",
			);
		} finally {
			setLoading(false);
		}
	});

	function setLoading(loading: boolean) {
		submitButton.disabled = loading;
		if (loading) {
			buttonText.classList.add("hidden");
			buttonLoading.classList.remove("hidden");
		} else {
			buttonText.classList.remove("hidden");
			buttonLoading.classList.add("hidden");
		}
	}

	function showMessage(message: string, type: "success" | "error") {
		messageDiv.textContent = message;
		messageDiv.classList.remove(
			"hidden",
			"text-[#c8922a]",
			"text-[#f87171]",
		);
		messageDiv.classList.add(
			type === "success" ? "text-[#c8922a]" : "text-[#f87171]",
		);
	}

	function hideMessage() {
		messageDiv.classList.add("hidden");
	}
</script>
