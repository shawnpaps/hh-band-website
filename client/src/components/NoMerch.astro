---
import EmailListSubscribe from "./EmailListSubscribe.astro";
---

<div>
	<div
		class="hero min-h-screen relative"
		style='background-image: url("https://hh-marketing-website.s3.us-east-2.amazonaws.com/HH_Promos+(11+of+37).jpg"); background-position: center 20%;'
	>
		<div class="hero-overlay bg-black/60"></div>
		<div class="text-center text-white mt-24 px-4">
			<h1
				class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold font-family-sancreek"
			>
				This Rest Stop is Under Construction.
			</h1>
			<p
				class="mt-4 text-lg sm:text-xl md:text-2xl italic font-family-chelsea max-w-3xl mx-auto"
			>
				No Merch Yet. In the meantime, join our community to get the
				latest updates from Homesick Highway
			</p>
			<EmailListSubscribe />
		</div>
	</div>
</div>
