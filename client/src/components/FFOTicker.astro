---
import { placeholderBands } from "../data/placeholder";
---

<div class="text-4xl font-bold text-white">
	<h2>If you like these bands</h2>
	<h3>You'll probably like us.</h3>
	<div class="marquee mt-5 overflow-hidden whitespace-nowrap bg-white">
		<div class="flex items-center gap-4">
			{
				placeholderBands.map((band) => (
					<div class="mx-10 w-48">
						<img
							class="w-full h-full object-cover"
							src={band.image}
						/>
					</div>
				))
			}
		</div>
	</div>
</div>
