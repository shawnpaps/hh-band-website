---
import { placeholderMerch } from "../data/placeholder";

const merchItems = placeholderMerch;
---

<div
	class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/8 border border-white/8"
>
	{
		merchItems.map((item) => (
			<div class="bg-[#111111] flex flex-col group">
				<div class="overflow-hidden aspect-square">
					<img
						src={item.image}
						alt={item.name}
						class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105"
					/>
				</div>
				<div class="p-8 flex flex-col flex-1 gap-4">
					<div>
						<h2
							class="text-3xl leading-none tracking-wide text-[#f0ece4]"
							style="font-family: 'Bebas Neue', Impact, sans-serif;"
						>
							{item.name}
						</h2>
						<p class="mt-2 text-sm text-white/50 leading-relaxed">
							{item.description}
						</p>
					</div>
					<div class="flex items-end justify-between mt-auto pt-4 border-t border-white/8">
						<p
							class="text-2xl leading-none text-[#f0ece4]"
							style="font-family: 'Bebas Neue', Impact, sans-serif;"
						>
							${item.price.toFixed(2)}
						</p>
						<button
							type="button"
							class="inline-flex items-center justify-center text-[0.75rem] font-semibold tracking-[0.12em] uppercase px-6 py-2.5 bg-[#c8922a] text-[#080808] border border-[#c8922a] hover:bg-[#a87520] hover:border-[#a87520] transition-colors duration-150 cursor-pointer"
						>
							Buy Now
						</button>
					</div>
				</div>
			</div>
		))
	}
</div>
