---
import EmailListSubscribe from "./EmailListSubscribe.astro";
const { heroText = "Homesick Highway", heroImageUrl = "" } = Astro.props;
---

<div class="hero min-h-screen relative">
	<img
		src={heroImageUrl}
		alt="Hero Image"
		class="w-full h-full object-cover"
	/>
	<h1
		class="text-[4em] sm:text-[8em] md:text-[12em] lg:text-[15em] leading-[0.8] max-w-xl absolute left-2 sm:left-4 md:left-0 bottom-10 sm:bottom-16 md:bottom-20 text-base-100 font-family-danfo"
	>
		{heroText}
	</h1>
	<div class="hero-overlay"></div>

	<!-- Countdown Timer -->
	<div
		class="sticky mb-auto top-0 sm:top-24 md:top-28 left-1/2 transform -translate-x-1/2 bg-orange-900/20 backdrop-blur-md p-4 sm:p-8 md:p-12 lg:p-5 rounded-xl text-center z-10 w-[95%] sm:w-auto max-w-5xl"
	>
		<h2
			class="text-2xl sm:text-3xl md:text-4xl lg:text-4xl font-bold text-white mb-3 sm:mb-4 font-family-danfo"
		>
			Lucid <span class="italic font-light text-black">Vision</span> Releases
			In:
		</h2>
		<div id="countdown" class="text-white font-family-chelsea">
			<div
				class="flex gap-2 sm:gap-3 md:gap-4 lg:gap-8 justify-center text-center"
			>
				<div class="flex flex-col stat">
					<span
						id="days"
						class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-bold"
						>00</span
					>
					<span
						class="text-xs sm:text-sm md:text-lg lg:text-xl mt-1 sm:mt-2 font-family-chelsea"
						>Days</span
					>
				</div>
				<div class="flex flex-col stat">
					<span
						id="hours"
						class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-bold"
						>00</span
					>
					<span
						class="text-xs sm:text-sm md:text-lg lg:text-xl mt-1 sm:mt-2 font-family-chelsea"
						>Hours</span
					>
				</div>
				<div class="flex flex-col stat">
					<span
						id="minutes"
						class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-bold"
						>00</span
					>
					<span
						class="text-xs sm:text-sm md:text-lg lg:text-xl mt-1 sm:mt-2 font-family-chelsea"
						>Minutes</span
					>
				</div>
				<div class="flex flex-col stat">
					<span
						id="seconds"
						class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl font-bold"
						>00</span
					>
					<span
						class="text-xs sm:text-sm md:text-lg lg:text-xl mt-1 sm:mt-2 font-family-chelsea"
						>Seconds</span
					>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	const releaseDate = new Date("2026-03-13T00:00:00").getTime();

	function updateCountdown() {
		const now = new Date().getTime();
		const distance = releaseDate - now;

		if (distance < 0) {
			document.getElementById("countdown")!.innerHTML =
				'<p class="text-5xl font-bold">🎉 OUT NOW! 🎉</p>';
			return;
		}

		const days = Math.floor(distance / (1000 * 60 * 60 * 24));
		const hours = Math.floor(
			(distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
		);
		const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
		const seconds = Math.floor((distance % (1000 * 60)) / 1000);
		const milliseconds = Math.floor(distance % 1000);

		document.getElementById("days")!.textContent = String(days).padStart(
			3,
			"0",
		);
		document.getElementById("hours")!.textContent = String(hours).padStart(
			2,
			"0",
		);
		document.getElementById("minutes")!.textContent = String(
			minutes,
		).padStart(2, "0");
		document.getElementById("seconds")!.textContent = String(
			seconds,
		).padStart(2, "0");
		document.getElementById("milliseconds")!.textContent = String(
			milliseconds,
		).padStart(3, "0");
	}

	// Update every 10ms for smooth millisecond animation
	setInterval(updateCountdown, 10);
	updateCountdown();
</script>
