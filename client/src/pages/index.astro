---
import Hero from "../components/Hero.astro";
import RootLayout from "../layouts/RootLayout.astro";
import NoMerch from "../components/NoMerch.astro";
---

<RootLayout
	title="Homesick Highway - Tampa Florida Hard Rock Country Metal Band | New Music 2026"
	description="Homesick Highway is Tampa's premier hard rock band fusing country and metal. Debut single 'Lucid Vision' out now. Experience Florida's most exciting new rock band with electrifying live shows and genre-bending sound."
	keywords="Homesick Highway, Tampa rock band, Florida hard rock, country metal band, new rock music 2026, Lucid Vision single, Tampa concerts, Florida metal band, hard rock Florida, southern rock Tampa, new bands Florida, rock music Tampa Bay"
	image="https://hh-marketing-website.s3.us-east-2.amazonaws.com/lucid-vision/Untitled.png"
>
	<!-- ─── Hero ──────────────────────────────────────────────────────────── -->
	<Hero
		heroText="Heavy As F**k Southern Rock from Tampa, FL"
		heroImageUrl="https://hh-marketing-website.s3.us-east-2.amazonaws.com/HH_Promos+(36+of+37).jpg"
		subText="Tampa, FL — Heavy Southern Rock"
	/>

	<!-- ─── Promo Video ──────────────────────────────────────────────────── -->
	<section class="bg-[#080808] border-b border-white/8">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 md:py-32">
			<p
				class="text-[0.6875rem] font-semibold tracking-[0.18em] uppercase text-[#c8922a] mb-4"
			>
				Watch
			</p>
			<div class="w-10 h-px bg-[#c8922a] mb-10"></div>
			<div class="w-full aspect-video border border-white/8">
				<iframe
					src="https://player.mux.com/FgF8Jk7XEZIhfSft8KTX8t01tEfyXdPx1uUVZRfyz41g?metadata-video-title=Homesick+Highway%3A+Single+Promo&video-title=Homesick+Highway%3A+Single+Promo"
					style="width: 100%; height: 100%; border: none;"
					allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
					allowfullscreen></iframe>
			</div>
		</div>
	</section>

	<!-- ─── Out Now Banner ───────────────────────────────────────────────── -->
	<section class="bg-[#111111] border-y border-white/8">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 md:py-20">
			<div class="flex flex-col md:flex-row md:items-end gap-8 md:gap-16">
				<!-- Label + headline -->
				<div class="flex-1">
					<p
						class="text-[0.6875rem] font-semibold tracking-[0.18em] uppercase text-[#c8922a] mb-4"
					>
						Debut Single
					</p>
					<h2
						class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl leading-none tracking-wide text-[#f0ece4]"
						style="font-family: 'Bebas Neue', Impact, sans-serif;"
					>
						Lucid<br /><span class="text-[#c8922a]">Vision</span>
					</h2>
					<p
						class="mt-4 text-sm text-white/45 tracking-widest uppercase"
					>
						Out Now
					</p>
				</div>

				<!-- Streaming links -->
				<div class="flex-shrink-0 flex flex-col gap-3">
					<a
						href="https://music.apple.com/us/album/lucid-vision/1881335715?i=1881335722"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-3 px-7 py-4 bg-[#080808] border border-white/15 hover:border-[#c8922a]/60 hover:bg-white/4 transition-all duration-150 group"
					>
						<!-- Apple Music icon -->
						<svg
							class="w-5 h-5 flex-shrink-0 text-white/60 group-hover:text-[#c8922a] transition-colors duration-150"
							viewBox="0 0 24 24"
							fill="currentColor"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M23.994 6.124a9.23 9.23 0 00-.24-2.19c-.317-1.31-1.062-2.31-2.18-3.043a5.022 5.022 0 00-1.877-.726 10.496 10.496 0 00-1.564-.15c-.04-.003-.083-.01-.124-.013H5.986c-.152.01-.303.017-.455.026C4.786.07 4.043.15 3.34.428 2.004.958 1.04 1.88.475 3.208A5.494 5.494 0 00.09 4.8a73.49 73.49 0 00-.089 1.19v12.02c.01.161.017.322.027.483.049.766.163 1.52.46 2.238.43 1.02 1.168 1.82 2.15 2.372.626.353 1.3.553 2.007.644.49.065.988.091 1.48.092h12.02c.49-.001.983-.027 1.472-.092.702-.091 1.37-.291 1.993-.644.985-.554 1.726-1.356 2.154-2.375.296-.718.41-1.47.46-2.235.01-.163.017-.326.027-.489V7.332c-.003-.403-.01-.806-.057-1.208zm-6.423 5.99l-4.507 2.818a.935.935 0 01-.492.14.957.957 0 01-.943-.958V8.673a.958.958 0 011.435-.831l4.507 2.818a.958.958 0 010 1.454z"
							></path>
						</svg>
						<span
							class="text-[0.8125rem] font-semibold tracking-[0.1em] uppercase text-[#f0ece4]"
						>
							Apple Music
						</span>
					</a>
					<a
						href="https://open.spotify.com/track/61W8lJuUnQeOjwrgHzWT09?si=e9105af723524d95"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-3 px-7 py-4 bg-[#080808] border border-white/15 hover:border-[#c8922a]/60 hover:bg-white/4 transition-all duration-150 group"
					>
						<!-- Spotify icon -->
						<svg
							class="w-5 h-5 flex-shrink-0 text-white/60 group-hover:text-[#c8922a] transition-colors duration-150"
							viewBox="0 0 24 24"
							fill="currentColor"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"
							></path>
						</svg>
						<span
							class="text-[0.8125rem] font-semibold tracking-[0.1em] uppercase text-[#f0ece4]"
						>
							Spotify
						</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── Single Spotlight ─────────────────────────────────────────────── -->
	<section id="music" class="bg-[#080808]">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 md:py-32">
			<div class="grid md:grid-cols-2 gap-12 lg:gap-20 items-center">
				<!-- Album art -->
				<div class="relative">
					<div
						class="absolute -inset-px bg-gradient-to-br from-[#c8922a]/30 to-transparent pointer-events-none"
					>
					</div>
					<img
						src="https://hh-marketing-website.s3.us-east-2.amazonaws.com/lucid-vision/Lucid_2.png"
						alt="Lucid Vision Album Cover"
						class="w-full aspect-square object-cover"
					/>
				</div>

				<!-- Info -->
				<div class="space-y-8">
					<div>
						<p
							class="text-[0.6875rem] font-semibold tracking-[0.18em] uppercase text-[#c8922a] mb-4"
						>
							Debut Single — Out Now
						</p>
						<h2
							class="text-6xl sm:text-7xl lg:text-8xl leading-none tracking-wide text-[#f0ece4]"
							style="font-family: 'Bebas Neue', Impact, sans-serif;"
						>
							Lucid Vision
						</h2>
						<p
							class="mt-3 text-sm tracking-widest uppercase text-white/40"
						>
							Homesick Highway — 2026
						</p>
					</div>

					<div class="w-10 h-px bg-[#c8922a]"></div>

					<p class="text-white/65 leading-relaxed text-lg">
						A high-energy call to shoot your shot and take the risk
						to live the life you want. Become what you're meant to
						be.
					</p>

					<div class="flex flex-wrap gap-4 pt-2">
						<a
							href="https://music.apple.com/us/album/lucid-vision/1881335715?i=1881335722"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center gap-2 text-[0.75rem] font-semibold tracking-[0.12em] uppercase px-7 py-3 bg-[#c8922a] text-[#080808] border border-[#c8922a] hover:bg-[#a87520] hover:border-[#a87520] transition-colors duration-150"
						>
							Apple Music
						</a>
						<a
							href="https://open.spotify.com/track/61W8lJuUnQeOjwrgHzWT09?si=e9105af723524d95"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center gap-2 text-[0.75rem] font-semibold tracking-[0.12em] uppercase px-7 py-3 bg-transparent text-[#f0ece4] border border-white/30 hover:bg-white/6 hover:border-white/55 transition-colors duration-150"
						>
							Spotify
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── Merch / Store ────────────────────────────────────────────────── -->
	<section id="store" class="bg-[#111111] border-t border-white/8">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 md:py-32">
			<div class="mb-12">
				<p
					class="text-[0.6875rem] font-semibold tracking-[0.18em] uppercase text-[#c8922a] mb-4"
				>
					Merch
				</p>
				<h2
					class="text-6xl sm:text-7xl md:text-8xl leading-none tracking-wide text-[#f0ece4]"
					style="font-family: 'Bebas Neue', Impact, sans-serif;"
				>
					From the Truck Stop
				</h2>
				<p class="mt-4 text-white/45 text-base">
					Pick up some merch and get back on the road.
				</p>
			</div>
			<NoMerch />
		</div>
	</section>
</RootLayout>
