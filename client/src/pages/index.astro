---
import RootLayout from "../layouts/RootLayout.astro";
---

<RootLayout
	title="Homesick Highway - Official Band Website"
	description="Rock band from the heart of America. Check out our latest music, upcoming shows, and more."
>
	<section>
		<h1 class="text-5xl font-bold text-center my-10">
			Welcome to Homesick Highway
		</h1>
		<p class="text-center text-xl max-w-3xl mx-auto">
			Discover the soulful sounds of Homesick Highway, a rock band that
			captures the essence of Americana through their heartfelt lyrics and
			captivating melodies. Explore our latest music, upcoming shows, and
			merchandise right here on our official website.
		</p>
	</section>
	<section class="h-screen z-10">
		<div class="grid grid-cols-4 grid-rows-4 min-h-[30em] gap-4">
			<div class="glass col-span-2 row-span-4 rounded-xl">some text</div>
			<div class="glass col-span-2 row-span-2 rounded-xl">some text</div>
			<div class="glass col-span-2 row-span-2 rounded-xl">some text</div>
		</div>
	</section>
</RootLayout>
