---
import Hero from "../components/Hero.astro";
import RootLayout from "../layouts/RootLayout.astro";
import NoMerch from "../components/NoMerch.astro";
---

<RootLayout
	title="Homesick Highway - Tampa Florida Hard Rock Country Metal Band | New Music 2026"
	description="Homesick Highway is Tampa's premier hard rock band fusing country and metal. Debut single 'Lucid Vision' drops March 13, 2026. Experience Florida's most exciting new rock band with electrifying live shows and genre-bending sound."
	keywords="Homesick Highway, Tampa rock band, Florida hard rock, country metal band, new rock music 2026, Lucid Vision single, Tampa concerts, Florida metal band, hard rock Florida, southern rock Tampa, new bands Florida, rock music Tampa Bay"
	image="https://hh-marketing-website.s3.us-east-2.amazonaws.com/lucid-vision/Untitled.png"
>
	<!-- ─── Hero ──────────────────────────────────────────────────────────── -->
	<Hero
		heroText="Heavy As F**k Southern Rock from Tampa, FL"
		heroImageUrl="https://hh-marketing-website.s3.us-east-2.amazonaws.com/HH_Promos+(36+of+37).jpg"
		subText="Tampa, FL — Heavy Southern Rock"
	/>

	<!-- ─── Promo Video ──────────────────────────────────────────────────── -->
	<section class="bg-[#080808] border-b border-white/8">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 md:py-32">
			<p
				class="text-[0.6875rem] font-semibold tracking-[0.18em] uppercase text-[#c8922a] mb-4"
			>
				Watch
			</p>
			<div class="w-10 h-px bg-[#c8922a] mb-10"></div>
			<div class="w-full aspect-video border border-white/8">
				<iframe
					src="https://player.mux.com/FgF8Jk7XEZIhfSft8KTX8t01tEfyXdPx1uUVZRfyz41g?metadata-video-title=Homesick+Highway%3A+Single+Promo&video-title=Homesick+Highway%3A+Single+Promo"
					style="width: 100%; height: 100%; border: none;"
					allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
					allowfullscreen></iframe>
			</div>
		</div>
	</section>

	<!-- ─── Countdown Banner ─────────────────────────────────────────────── -->
	<section class="bg-[#111111] border-y border-white/8 p-5">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 md:py-20">
			<div class="flex flex-col md:flex-row md:items-end gap-8 md:gap-16">
				<!-- Label + headline -->
				<div class="flex-1">
					<p
						class="text-[0.6875rem] font-semibold tracking-[0.18em] uppercase text-[#c8922a] mb-4"
					>
						Debut Single
					</p>
					<h2
						class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl leading-none tracking-wide text-[#f0ece4]"
						style="font-family: 'Bebas Neue', Impact, sans-serif;"
					>
						Lucid<br /><span class="text-[#c8922a]">Vision</span>
					</h2>
					<p
						class="mt-4 text-sm text-white/45 tracking-widest uppercase"
					>
						March 13, 2026
					</p>
				</div>

				<!-- Countdown clock -->
				<div class="flex-shrink-0">
					<div
						id="countdown"
						class="grid grid-cols-4 gap-px bg-white/8 border border-white/8"
					>
						{
							["days", "hours", "minutes", "seconds"].map(
								(unit) => (
									<div class="bg-[#080808] px-5 py-6 text-center min-w-[72px]">
										<span
											id={unit}
											class="block text-4xl md:text-5xl leading-none text-[#f0ece4]"
											style="font-family: 'Bebas Neue', Impact, sans-serif;"
										>
											00
										</span>
										<span class="block mt-2 text-[10px] font-semibold tracking-[0.18em] uppercase text-white/35">
											{unit}
										</span>
									</div>
								),
							)
						}
					</div>
					<div class="mt-6">
						<a
							href="#"
							class="inline-flex items-center justify-center w-full text-[0.75rem] font-semibold tracking-[0.12em] uppercase px-7 py-3 border border-white/30 text-[#f0ece4] opacity-40 cursor-not-allowed pointer-events-none"
						>
							Pre-save Coming Soon
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── Single Spotlight ─────────────────────────────────────────────── -->
	<section id="music" class="bg-[#080808]">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 md:py-32">
			<div class="grid md:grid-cols-2 gap-12 lg:gap-20 items-center">
				<!-- Album art -->
				<div class="relative">
					<div
						class="absolute -inset-px bg-gradient-to-br from-[#c8922a]/30 to-transparent pointer-events-none"
					>
					</div>
					<img
						src="https://hh-marketing-website.s3.us-east-2.amazonaws.com/lucid-vision/Lucid_2.png"
						alt="Lucid Vision Album Cover"
						class="w-full aspect-square object-cover"
					/>
				</div>

				<!-- Info -->
				<div class="space-y-8">
					<div>
						<p
							class="text-[0.6875rem] font-semibold tracking-[0.18em] uppercase text-[#c8922a] mb-4"
						>
							New Single
						</p>
						<h2
							class="text-6xl sm:text-7xl lg:text-8xl leading-none tracking-wide text-[#f0ece4]"
							style="font-family: 'Bebas Neue', Impact, sans-serif;"
						>
							Lucid Vision
						</h2>
						<p
							class="mt-3 text-sm tracking-widest uppercase text-white/40"
						>
							Homesick Highway — 2026
						</p>
					</div>

					<div class="w-10 h-px bg-[#c8922a]"></div>

					<p class="text-white/65 leading-relaxed text-lg">
						A high-energy call to shoot your shot and take the risk
						to live the life you want. Become what you're meant to
						be.
					</p>

					<div class="flex flex-wrap gap-4 pt-2">
						<a
							href="#"
							class="inline-flex items-center justify-center text-[0.75rem] font-semibold tracking-[0.12em] uppercase px-7 py-3 bg-[#c8922a] text-[#080808] border border-[#c8922a] opacity-40 cursor-not-allowed pointer-events-none"
						>
							Pre-save Link Coming Soon
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── Merch / Store ────────────────────────────────────────────────── -->
	<section id="store" class="bg-[#111111] border-t border-white/8">
		<div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 md:py-32">
			<div class="mb-12">
				<p
					class="text-[0.6875rem] font-semibold tracking-[0.18em] uppercase text-[#c8922a] mb-4"
				>
					Merch
				</p>
				<h2
					class="text-6xl sm:text-7xl md:text-8xl leading-none tracking-wide text-[#f0ece4]"
					style="font-family: 'Bebas Neue', Impact, sans-serif;"
				>
					From the Truck Stop
				</h2>
				<p class="mt-4 text-white/45 text-base">
					Pick up some merch and get back on the road.
				</p>
			</div>
			<NoMerch />
		</div>
	</section>
</RootLayout>

<script>
	const releaseDate = new Date("2026-03-13T00:00:00").getTime();

	const daysEl = document.getElementById("days");
	const hoursEl = document.getElementById("hours");
	const minutesEl = document.getElementById("minutes");
	const secondsEl = document.getElementById("seconds");

	function pad(n: number, digits = 2) {
		return String(n).padStart(digits, "0");
	}

	function updateCountdown() {
		const now = Date.now();
		const distance = releaseDate - now;

		if (distance <= 0) {
			const el = document.getElementById("countdown");
			if (el) {
				el.innerHTML = `<div class="col-span-4 px-10 py-8 bg-[#080808] text-center text-4xl tracking-widest text-[#c8922a]" style="font-family:'Bebas Neue',Impact,sans-serif;">Out Now</div>`;
			}
			return;
		}

		const d = Math.floor(distance / (1000 * 60 * 60 * 24));
		const h = Math.floor(
			(distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
		);
		const m = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
		const s = Math.floor((distance % (1000 * 60)) / 1000);

		if (daysEl) daysEl.textContent = pad(d, 3);
		if (hoursEl) hoursEl.textContent = pad(h);
		if (minutesEl) minutesEl.textContent = pad(m);
		if (secondsEl) secondsEl.textContent = pad(s);
	}

	setInterval(updateCountdown, 1000);
	updateCountdown();
</script>
