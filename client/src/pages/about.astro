---
import RootLayout from "../layouts/RootLayout.astro";

const bioLong = `Homesick Highway is a band hailing from the Florida swamps, blending styles of their hardcore/metalcore roots and their love of country music to create a unique sound of their own. The band strives to push the music industry through their southern riffs, catchy choruses, hard-hitting breakdowns, meaningful lyrics, and a rebellious sense of fun.

Their debut single "Lucid Vision" is high energy call to the listener to shoot their shot and take the risk to live a life that they want to live. Become what you're meant to be.`;
---

<RootLayout
	title="About Homesick Highway - Tampa Florida Hard Rock Country Metal Band"
	description="Learn about Homesick Highway, Tampa's premier hard rock band blending hardcore/metalcore roots with country music. Discover the story behind Florida's most exciting new rock band."
	keywords="Homesick Highway about, Tampa rock band story, Florida hard rock band, country metal fusion, hardcore metalcore Florida, band biography, Tampa music scene"
>
	<!-- Hero Section -->
	<section
		class="relative min-h-[60vh] flex items-center justify-center overflow-hidden"
	>
		<div class="absolute inset-0 z-0">
			<img
				src="https://hh-marketing-website.s3.us-east-2.amazonaws.com/HH_Promos+(36+of+37).jpg"
				alt="Homesick Highway Band"
				class="w-full h-full object-cover"
			/>
			<div
				class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-black/90"
			>
			</div>
		</div>

		<div class="relative z-10 container mx-auto px-4 py-20 text-center">
			<h1
				class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-bold font-family-danfo text-white leading-none mb-6"
			>
				About <span class="italic font-light text-orange-400">Us</span>
			</h1>
			<p
				class="text-xl sm:text-2xl md:text-3xl text-white/80 font-family-chelsea italic max-w-3xl mx-auto"
			>
				From the Florida swamps to the stage
			</p>
		</div>
	</section>

	<!-- Bio Section -->
	<section class="py-16 md:py-24 bg-base-100">
		<div class="container mx-auto px-4 max-w-5xl">
			<div class="space-y-8">
				<div class="space-y-6 text-center md:text-left">
					{
						bioLong
							.split("\n\n")
							.map((paragraph) => (
								<p class="text-xl sm:text-2xl md:text-3xl leading-relaxed font-family-chelsea text-black/90">
									{paragraph}
								</p>
							))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- Band Photo Section -->
	<section class="py-16 md:py-24 bg-black">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<img
					src="https://hh-marketing-website.s3.us-east-2.amazonaws.com/HH_Promos+(36+of+37).jpg"
					alt="Homesick Highway Band Photo"
					class="w-full rounded-lg shadow-2xl"
				/>
			</div>
		</div>
	</section>

	<!-- Sound Description -->
	<section class="py-16 md:py-24 bg-base-100">
		<div class="container mx-auto px-4 max-w-4xl text-center">
			<h2
				class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold font-family-sancreek mb-8"
			>
				Our Sound
			</h2>
			<div class="space-y-6">
				<p
					class="text-2xl sm:text-3xl md:text-4xl font-family-danfo text-orange-600"
				>
					Southern Riffs + Hard-Hitting Breakdowns + Outlaw
					Storytelling
				</p>
				<p
					class="text-xl sm:text-2xl font-family-chelsea text-black/80 italic"
				>
					Where roadhouse country meets the intensity of the pit
				</p>
			</div>
		</div>
	</section>

	<!-- For Fans Of Section -->
	<section class="py-16 md:py-24 bg-black text-white">
		<div class="container mx-auto px-4 max-w-5xl">
			<h2
				class="text-4xl sm:text-5xl md:text-6xl font-bold font-family-sancreek text-center mb-12"
			>
				For Fans Of
			</h2>
			<div
				class="flex flex-wrap justify-center items-center gap-6 md:gap-8 lg:gap-12"
			>
				<div
					class="text-2xl sm:text-3xl md:text-4xl font-family-danfo text-orange-400 hover:text-orange-300 transition-colors"
				>
					A Day To Remember
				</div>
				<div class="text-4xl text-white/30">•</div>
				<div
					class="text-2xl sm:text-3xl md:text-4xl font-family-danfo text-orange-400 hover:text-orange-300 transition-colors"
				>
					HARDY
				</div>
				<div class="text-4xl text-white/30">•</div>
				<div
					class="text-2xl sm:text-3xl md:text-4xl font-family-danfo text-orange-400 hover:text-orange-300 transition-colors"
				>
					Lakeview
				</div>
				<div class="text-4xl text-white/30">•</div>
				<div
					class="text-2xl sm:text-3xl md:text-4xl font-family-danfo text-orange-400 hover:text-orange-300 transition-colors"
				>
					Nickelback
				</div>
				<div class="text-4xl text-white/30">•</div>
				<div
					class="text-2xl sm:text-3xl md:text-4xl font-family-danfo text-orange-400 hover:text-orange-300 transition-colors"
				>
					Gideon
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-16 md:py-24 bg-black text-white">
		<div class="container mx-auto px-4 text-center">
			<h2
				class="text-4xl sm:text-5xl md:text-6xl font-bold font-family-danfo mb-8"
			>
				Ready to Experience <span
					class="italic font-light text-orange-400"
					>Homesick Highway</span
				>?
			</h2>
			<div class="flex flex-col sm:flex-row gap-4 justify-center mt-12">
				<a
					href="/#music"
					class="btn btn-accent btn-lg px-8 font-family-chelsea text-lg hover:scale-105 transition-transform"
				>
					Listen to Our Music
				</a>
				<a
					href="/shows"
					class="btn btn-outline btn-lg px-8 font-family-chelsea text-lg hover:scale-105 transition-transform"
				>
					See Us Live
				</a>
			</div>
		</div>
	</section>
</RootLayout>
