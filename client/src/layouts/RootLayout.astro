---
import "../styles/global.css";
import SubscribeModal from "../components/SubscribeModal.astro";
import LucidVisionPlayer from "../components/LucidVisionPlayer.astro";

export interface Props {
	title?: string;
	description?: string;
}

const { title = "Homesick Highway", description = "Official band website" } =
	Astro.props;
---

<!doctype html>
<html lang="en" data-theme="retro">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Chelsea+Market&family=Danfo&family=Sancreek&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="relative">
		<header
			class="fixed top-0 left-0 z-10 w-full bg-white/20 backdrop-blur-sm text-black"
		>
			<div class="p-5 flex items-center justify-between">
				<a href="/">
					<h1
						class="text-6xl font-semibold hover:text-white ease-linear transition-all"
					>
						HMSCK HWY
					</h1>
				</a>
				<nav>
					<ul class="flex gap-5 text-3xl font-semibold items-center">
						<li class="hover:text-white transition-all ease-linear">
							<a href="#music">MUSIC</a>
						</li>
						<li class="hover:text-white transition-all ease-linear">
							<a href="/shows">SHOWS</a>
						</li>
						<li class="hover:text-white transition-all ease-linear">
							<a href="/press">PRESS</a>
						</li>
						<li class="hover:text-white transition-all ease-linear">
							<a href="#about">STORE</a>
						</li>
						<li>
							<button
								class="btn btn-xl btn-outline bg-black/50 rounded-full hover:bg-amber-500 transition-colors ease-linear"
								>TEXT US</button
							>
						</li>
					</ul>
				</nav>
			</div>
		</header>
		<main class="min-h-screen flex flex-col relative">
			<slot />
		</main>
		<LucidVisionPlayer />
		<SubscribeModal delay={3000} />
	</body>
</html>
