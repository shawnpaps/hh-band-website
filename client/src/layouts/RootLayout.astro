---
import "../styles/global.css";
import SubscribeModal from "../components/SubscribeModal.astro";
import ChatBot from "../components/ChatBot.astro";

export interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	image?: string;
}

const {
	title = "Homesick Highway",
	description = "Official band website",
	keywords = "",
	image = "",
} = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
	{ href: "/#music", label: "Music" },
	{ href: "/shows", label: "Shows" },
	{ href: "/about", label: "About" },
	{ href: "/press", label: "Press" },
];

const socialLinks = [
	{ href: "https://www.instagram.com/homesickhighway", label: "Instagram" },
	{ href: "https://www.tiktok.com/@homesickhighway", label: "TikTok" },
	{ href: "https://www.facebook.com/homesickhighway", label: "Facebook" },
	{ href: "https://www.youtube.com/@homesickhighway", label: "YouTube" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		{image && <meta property="og:image" content={image} />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:ital,opsz,wght@0,14..32,300;0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,300;1,14..32,400&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="bg-[#080808] text-[#f0ece4] antialiased">
		<!-- ─── Header ─────────────────────────────────────────────────────── -->
		<header
			id="site-header"
			class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
		>
			<div
				class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 lg:px-10"
			>
				<!-- Wordmark -->
				<a
					href="/"
					class="text-2xl tracking-widest text-[#f0ece4] hover:text-[#c8922a] transition-colors duration-150 leading-none"
					style="font-family: 'Bebas Neue', Impact, sans-serif;"
				>
					Homesick Highway
				</a>

				<!-- Desktop Nav -->
				<nav class="hidden md:flex items-center gap-8">
					{
						navLinks.map((link) => (
							<a
								href={link.href}
								class={`text-xs font-semibold tracking-[0.14em] uppercase transition-colors duration-150 ${currentPath === link.href ? "text-[#f0ece4]" : "text-white/60 hover:text-[#f0ece4]"}`}
							>
								{link.label}
							</a>
						))
					}
				</nav>

				<!-- Mobile menu toggle -->
				<button
					id="mobile-menu-btn"
					aria-label="Open menu"
					aria-expanded="false"
					class="md:hidden flex flex-col gap-[5px] p-2 cursor-pointer"
				>
					<span
						id="bar1"
						class="block h-px w-6 bg-[#f0ece4] transition-all duration-200 origin-center"
					></span>
					<span
						id="bar2"
						class="block h-px w-6 bg-[#f0ece4] transition-all duration-200"
					></span>
					<span
						id="bar3"
						class="block h-px w-6 bg-[#f0ece4] transition-all duration-200 origin-center"
					></span>
				</button>
			</div>

			<!-- Mobile Nav Drawer -->
			<nav
				id="mobile-menu"
				class="hidden md:hidden border-t border-white/8 bg-[#080808]/95 backdrop-blur-md"
			>
				<ul class="flex flex-col px-6 py-6 gap-5">
					{
						navLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-sm font-semibold tracking-widest uppercase text-white/60 hover:text-[#f0ece4] transition-colors duration-150"
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</header>

		<!-- ─── Page Content ───────────────────────────────────────────────── -->
		<main class="">
			<slot />
		</main>

		<!-- ─── Footer ────────────────────────────────────────────────────── -->
		<footer class="border-t border-white/8 bg-[#080808]">
			<div class="mx-auto max-w-7xl px-6 lg:px-10 py-16">
				<div
					class="flex flex-col md:flex-row items-start md:items-center justify-between gap-10"
				>
					<!-- Brand -->
					<div class="space-y-4 max-w-xs">
						<p
							class="text-3xl tracking-widest text-[#f0ece4] leading-none"
							style="font-family: 'Bebas Neue', Impact, sans-serif;"
						>
							Homesick Highway
						</p>
						<p class="text-sm text-white/45 leading-relaxed">
							Heavy southern riffs, hardcore breakdowns, and
							outlaw storytelling. Tampa, FL.
						</p>
					</div>

					<!-- Nav + Social -->
					<div class="flex flex-col sm:flex-row gap-10">
						<!-- Site links -->
						<div class="space-y-3">
							<p
								class="text-[0.6875rem] font-semibold tracking-[0.18em] uppercase text-[#c8922a]"
							>
								Navigate
							</p>
							<ul class="space-y-2">
								{
									navLinks.map((link) => (
										<li>
											<a
												href={link.href}
												class="text-sm text-white/55 hover:text-[#f0ece4] transition-colors duration-150"
											>
												{link.label}
											</a>
										</li>
									))
								}
							</ul>
						</div>

						<!-- Social links -->
						<div class="space-y-3">
							<p
								class="text-[0.6875rem] font-semibold tracking-[0.18em] uppercase text-[#c8922a]"
							>
								Follow
							</p>
							<ul class="space-y-2">
								{
									socialLinks.map((link) => (
										<li>
											<a
												href={link.href}
												target="_blank"
												rel="noopener noreferrer"
												class="text-sm text-white/55 hover:text-[#f0ece4] transition-colors duration-150"
											>
												{link.label}
											</a>
										</li>
									))
								}
							</ul>
						</div>
					</div>
				</div>

				<!-- Bottom bar -->
				<div
					class="mt-12 pt-6 border-t border-white/8 flex flex-col sm:flex-row items-center justify-between gap-4"
				>
					<p class="text-xs text-white/30 tracking-wide">
						&copy; {new Date().getFullYear()} Homesick Highway. All rights
						reserved.
					</p>
					<a
						href="mailto:booking@homesickhighway.com"
						class="text-xs text-white/30 hover:text-[#c8922a] transition-colors duration-150 tracking-wide"
					>
						booking@homesickhighway.com
					</a>
				</div>
			</div>
		</footer>

		<SubscribeModal delay={4000} />
		<ChatBot />

		<!-- ─── Header scroll + mobile menu script ────────────────────────── -->
		<script is:inline>
			const header = document.getElementById("site-header");

			const updateHeader = () => {
				if (window.scrollY > 40) {
					header.classList.add(
						"bg-[#080808]/90",
						"backdrop-blur-md",
						"border-b",
						"border-white/8",
					);
				} else {
					header.classList.remove(
						"bg-[#080808]/90",
						"backdrop-blur-md",
						"border-b",
						"border-white/8",
					);
				}
			};

			window.addEventListener("scroll", updateHeader, { passive: true });
			updateHeader();

			const btn = document.getElementById("mobile-menu-btn");
			const menu = document.getElementById("mobile-menu");
			const bar1 = document.getElementById("bar1");
			const bar2 = document.getElementById("bar2");
			const bar3 = document.getElementById("bar3");

			btn.addEventListener("click", () => {
				const isOpen = !menu.classList.contains("hidden");
				if (isOpen) {
					menu.classList.add("hidden");
					btn.setAttribute("aria-expanded", "false");
					bar1.style.transform = "";
					bar2.style.opacity = "";
					bar3.style.transform = "";
				} else {
					menu.classList.remove("hidden");
					btn.setAttribute("aria-expanded", "true");
					bar1.style.transform = "translateY(7px) rotate(45deg)";
					bar2.style.opacity = "0";
					bar3.style.transform = "translateY(-7px) rotate(-45deg)";
				}
			});

			menu.querySelectorAll("a").forEach((link) => {
				link.addEventListener("click", () => {
					menu.classList.add("hidden");
					btn.setAttribute("aria-expanded", "false");
					bar1.style.transform = "";
					bar2.style.opacity = "";
					bar3.style.transform = "";
				});
			});
		</script>
	</body>
</html>
