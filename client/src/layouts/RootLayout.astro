---
import "../styles/global.css";
import SubscribeModal from "../components/SubscribeModal.astro";
import LucidVisionPlayer from "../components/LucidVisionPlayer.astro";

export interface Props {
	title?: string;
	description?: string;
}

const { title = "Homesick Highway", description = "Official band website" } =
	Astro.props;
---

<!doctype html>
<html lang="en" data-theme="retro">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Chelsea+Market&family=Danfo&family=Sancreek&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="relative">
		<header
			class="fixed top-0 left-0 z-20 w-full bg-white/20 backdrop-blur-sm text-black"
		>
			<div class="p-3 md:p-5 flex items-center justify-between">
				<a href="/">
					<h1
						class="text-3xl md:text-6xl font-semibold hover:text-white ease-linear transition-all"
					>
						HMSCK HWY
					</h1>
				</a>

				<!-- Mobile Menu Button -->
				<button
					id="mobile-menu-btn"
					class="md:hidden text-3xl hover:text-white transition-all"
				>
					☰
				</button>

				<!-- Desktop Navigation -->
				<nav class="hidden md:block">
					<ul class="flex gap-5 text-3xl font-semibold items-center">
						<li class="hover:text-white transition-all ease-linear">
							<a href="/#music">MUSIC</a>
						</li>
						<li class="hover:text-white transition-all ease-linear">
							<a href="/shows">SHOWS</a>
						</li>
					</ul>
				</nav>
			</div>

			<!-- Mobile Navigation -->
			<nav
				id="mobile-menu"
				class="hidden md:hidden bg-black/90 backdrop-blur-md"
			>
				<ul
					class="flex flex-col gap-4 p-5 text-2xl font-semibold text-white"
				>
					<li class="hover:text-amber-500 transition-all ease-linear">
						<a href="/#music" class="block py-2">MUSIC</a>
					</li>
					<li class="hover:text-amber-500 transition-all ease-linear">
						<a href="/shows" class="block py-2">SHOWS</a>
					</li>
				</ul>
			</nav>
		</header>

		<script is:inline>
			const mobileMenuBtn = document.getElementById("mobile-menu-btn");
			const mobileMenu = document.getElementById("mobile-menu");

			mobileMenuBtn?.addEventListener("click", () => {
				mobileMenu?.classList.toggle("hidden");
			});

			// Close mobile menu when clicking a link
			mobileMenu?.querySelectorAll("a").forEach((link) => {
				link.addEventListener("click", () => {
					mobileMenu.classList.add("hidden");
				});
			});
		</script>
		<main class="min-h-screen flex flex-col relative">
			<slot />
		</main>
		<!-- <LucidVisionPlayer /> -->
		<SubscribeModal delay={3000} />
		<footer class="p-5 text-center text-sm text-base-content/80">
			<p>
				&copy; {new Date().getFullYear()} Homesick Highway. All rights reserved.
			</p>
		</footer>
	</body>
</html>
